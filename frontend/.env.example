# Base URL of the Laravel API. Leave unset in development - the Vite dev
# server proxies /api to http://127.0.0.1:8000 (see vite.config.js), which
# keeps everything same-origin and avoids CORS entirely. Set this only when
# building for an environment where that proxy does not apply.
# VITE_API_URL=https://api.covoiturage.tn/api
